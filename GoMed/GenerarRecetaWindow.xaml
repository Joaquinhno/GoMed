<UserControl x:Class="GoMed.GenerarRecetaWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,30" MaxWidth="1100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="Generador de Recetas" Style="{StaticResource ViewTitleStyle}"/>
                <TextBlock Text="Agregue los medicamentos y genere el PDF profesional" Style="{StaticResource ViewSubtitleStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <!-- Tarjeta 1: Selección de Paciente -->
                <Border Style="{StaticResource GoMedCardStyle}">
                    <StackPanel>
                        <Label Content="Paciente Destinatario" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Border Background="White" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" Padding="5">
                            <ComboBox x:Name="cmbPaciente" IsEditable="True" BorderThickness="0" Height="32" DisplayMemberPath="NombreCompleto" SelectedValuePath="PacienteID"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Carga de Medicamento -->
                <Border Style="{StaticResource GoMedCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <Label Content="Medicamento (Genérico / Comercial)" FontWeight="Bold"/>
                            <TextBox x:Name="txtMedicamento" Height="38" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <Label Content="Dosis y Frecuencia (ej: 500mg cada 8hs)" FontWeight="Bold"/>
                            <TextBox x:Name="txtDosis" Height="38" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15,0,0">
                            <Label Content="Instrucciones Adicionales (ej: después de las comidas)" FontWeight="Bold"/>
                            <TextBox x:Name="txtInstrucciones" Height="65" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8"/>
                        </StackPanel>

                        <Button Grid.Row="2" Grid.Column="2" x:Name="btnAgregarLista" Content="+ Añadir a la Receta"
                                Style="{StaticResource BaseButtonStyle}"
                                Background="{StaticResource LightBlueHover}" Foreground="{StaticResource PrimaryBlueBrush}"
                                BorderBrush="{StaticResource PrimaryBlueBrush}"
                                Margin="0,20,0,0" Click="BtnAgregarLista_Click"/>
                    </Grid>
                </Border>

                <!-- Tarjeta 3: Tabla Temporal de Medicamentos -->
                <Border Style="{StaticResource GoMedCardStyle}">
                    <StackPanel>
                        <Label Content="Medicamentos en esta Receta" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="dgRecetaTemporal" AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="White" BorderBrush="#EEE" RowHeight="38" FontSize="14" Height="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Medicamento" Binding="{Binding Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Dosis" Binding="{Binding Dosis}" Width="*"/>
                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Quitar" Background="Transparent" Foreground="#DC3545" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnQuitarMedicamento_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Botones Finales -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,30">
                    <Button Content="Limpiar Todo" Style="{StaticResource CancelButtonStyle}" Margin="0,0,12,0" Click="BtnLimpiarTodo_Click"/>

                    <Button x:Name="btnPrevisualizar" Content="👁 Previsualizar" Click="BtnPrevisualizar_Click"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="#E8F0F8" Foreground="{StaticResource PrimaryBlueBrush}" BorderBrush="{StaticResource PrimaryBlueBrush}"
                            Margin="0,0,12,0"/>

                    <Button x:Name="btnGenerarPDF" Content="💾 Generar y Guardar PDF"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="BtnGenerarPDF_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>