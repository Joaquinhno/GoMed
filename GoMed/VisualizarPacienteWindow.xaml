<Window x:Class="GoMed.VisualizarPacientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Listado de Pacientes" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F8F9FA">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Buscar Paciente" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtBusqueda" Height="40" VerticalContentAlignment="Center" 
                         Padding="10,0" FontSize="16" Tag="Ingrese DNI o Nombre..." 
                         TextChanged="TxtBusqueda_TextChanged"/>
                <TextBlock IsHitTestVisible="False" Text="🔍 Buscar por DNI o Nombre..." VerticalAlignment="Center" 
                           HorizontalAlignment="Left" Margin="15,0,0,0" Foreground="Gray" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtBusqueda}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgPacientes" AutoGenerateColumns="False" 
                  IsReadOnly="True" Background="White" BorderBrush="#EEE" 
                  RowHeight="40" FontSize="14" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="120"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="*"/>
                <DataGridTextColumn Header="F. Nacimiento" Binding="{Binding FechaNacimiento, StringFormat=\{0:dd/MM/yyyy\}}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">

            <Button Content="Editar Paciente" Width="140" Height="40" 
                    Background="#FFC107" Foreground="#333" FontWeight="Bold" BorderThickness="0"
                    Click="BtnEditar_Click" Margin="0,0,10,0" Cursor="Hand"/>

            <Button Content="Eliminar" Width="100" Height="40" 
                    Background="#DC3545" Foreground="White" FontWeight="Bold" BorderThickness="0"
                    Click="BtnEliminar_Click" Margin="0,0,15,0" Cursor="Hand"/>

            <Button Content="Ver Ficha Detallada" Width="180" Height="40" 
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                    Background="#007BFF" Foreground="White" FontWeight="Bold" 
                    Click="BtnVerFicha_Click" Margin="0,0,10,0"/>

            <Button Content="Cerrar" Width="100" Height="40" Click="BtnCerrar_Click" Cursor="Hand"/>

        </StackPanel>
    </Grid>
</Window>