<UserControl x:Class="GoMed.VisualizarPacientesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Encabezado + Botón Nuevo Paciente -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Listado de Pacientes" Style="{StaticResource ViewTitleStyle}"/>
                <TextBlock Text="Busque, edite o consulte la ficha clínica de sus pacientes registrados" Style="{StaticResource ViewSubtitleStyle}"/>
            </StackPanel>

            <Button Content="➕ Nuevo Paciente" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}" Click="BtnNuevoPaciente_Click"/>
        </Grid>

        <!-- 2. Buscador -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,20">
            <Grid>
                <TextBox x:Name="txtBusqueda" Height="45" VerticalContentAlignment="Center"
                         Padding="40,0,15,0" FontSize="15" BorderThickness="0" Background="Transparent"
                         Tag="Ingrese DNI o Nombre..."
                         TextChanged="TxtBusqueda_TextChanged"/>
                <TextBlock IsHitTestVisible="False" Text="🔍   Buscar por DNI, Nombre o Apellido..."
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0"
                           Foreground="#AAA" FontSize="15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtBusqueda}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 3. Tabla de Pacientes en Tarjeta -->
        <Border Grid.Row="2" Style="{StaticResource GoMedCardStyle}" Padding="10" Margin="0">
            <DataGrid x:Name="dgPacientes" AutoGenerateColumns="False"
                      IsReadOnly="True" Background="Transparent" BorderThickness="0"
                      RowHeight="44" FontSize="14" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#888888"/>
                        <Setter Property="Padding" Value="15,0,0,12"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8F9FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E8F4FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="140"/>
                    <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="APELLIDO" Binding="{Binding Apellido}" Width="*"/>
                    <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="150"/>
                    <DataGridTextColumn Header="F. NACIMIENTO" Binding="{Binding FechaNacimiento, StringFormat=\{0:dd/MM/yyyy\}}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. Barra de Acciones Inferior -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="✏️ Editar Paciente"
                    Style="{StaticResource BaseButtonStyle}"
                    Background="#FFC107" BorderBrush="#FFC107" Foreground="#333"
                    Click="BtnEditar_Click" Margin="0,0,10,0"/>

            <Button Content="🗑️ Eliminar"
                    Style="{StaticResource BaseButtonStyle}"
                    Background="#DC3545" BorderBrush="#DC3545" Foreground="White"
                    Click="BtnEliminar_Click" Margin="0,0,10,0"/>

            <Button Content="📋 Ver Ficha Detallada"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="BtnVerFicha_Click"/>
        </StackPanel>
    </Grid>
</UserControl>