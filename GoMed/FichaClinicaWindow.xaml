<UserControl x:Class="GoMed.FichaClinicaWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:GoMed"
             mc:Ignorable="d"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30" MaxWidth="1100">

            <!-- Encabezado -->
            <StackPanel Margin="0,0,0,25">
                <TextBlock Text="Ficha Clínica del Paciente" Style="{StaticResource ViewTitleStyle}"/>
                <TextBlock Text="Seleccione un paciente para registrar o actualizar sus antecedentes médicos" Style="{StaticResource ViewSubtitleStyle}"/>
            </StackPanel>

            <!-- Buscador de Paciente en Tarjeta -->
            <Border Style="{StaticResource GoMedCardStyle}">
                <StackPanel>
                    <Label Content="Buscar Paciente (por Nombre o DNI)"/>
                    <ComboBox x:Name="cmbPaciente"
                              IsEditable="True"
                              SelectionChanged="CmbPaciente_SelectionChanged"/>
                </StackPanel>
            </Border>

            <!-- Campos de la Ficha en Tarjeta -->
            <Border Style="{StaticResource GoMedCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <Label Content="👤 Antecedentes Personales"/>
                            <TextBox x:Name="txtAntecedentesPersonales"
                                     Height="185"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <Label Content="👨‍👩‍👧 Antecedentes Familiares"/>
                            <TextBox x:Name="txtAntecedentesFamiliares"
                                     Height="185"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <Label Content="💪 Examen Físico"/>
                            <TextBox x:Name="txtExamenFisico"
                                     Height="185"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="10"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <Label Content="📄 Notas Adicionales"/>
                            <TextBox x:Name="txtNotas"
                                     Height="185"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="10"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                        <Button x:Name="btnCancelar" Content="Deshacer Cambios" Style="{StaticResource CancelButtonStyle}" Click="BtnCancelar_Click"/>
                        <Button x:Name="btnGuardar" Content="💾 Guardar Ficha" Style="{StaticResource SaveButtonStyle}" Margin="12,0,0,0" Click="BtnGuardar_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>