<Window x:Class="GoMed.DetalleConsultaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de Consulta" Height="750" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F8F9FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <TextBlock x:Name="lblTitulo" Text="Detalle de la Consulta" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,10"/>
            <TextBlock x:Name="lblInfoPaciente" Text="Paciente: ..." FontSize="16" Foreground="#666" Margin="0,0,0,25"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Motivo de la Consulta:" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}"/>
                    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="15" MinHeight="150" Margin="0,5,0,0">
                        <TextBlock x:Name="txtMotivoDetalle" TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="#333"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Diagnóstico y Tratamiento:" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="15" MinHeight="150" Margin="0,5,0,0">
                        <TextBlock x:Name="txtTratamientoDetalle" TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="#333"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Label Content="Fotografías Adjuntas:" Margin="0,25,0,5" FontWeight="Bold"/>
            <ItemsControl x:Name="icFotos">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Background="White" Padding="5" Cursor="Hand">
                            <Image Source="{Binding}" Width="180" Height="140" Stretch="UniformToFill" MouseDown="Image_MouseDown"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Cerrar" HorizontalAlignment="Right" Width="120" Margin="0,30,0,0" Style="{StaticResource CancelButtonStyle}" Click="BtnCerrar_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>