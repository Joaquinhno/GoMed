<UserControl x:Class="GoMed.DetalleConsultaWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30" MaxWidth="1100">
            <TextBlock x:Name="lblTitulo" Text="Detalle de la Consulta" Style="{StaticResource ViewTitleStyle}" Margin="0,0,0,6"/>
            <TextBlock x:Name="lblInfoPaciente" Text="Paciente: ..." FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueBrush}" Margin="2,0,0,25"/>

            <Border Style="{StaticResource GoMedCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Motivo de la Consulta:" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}"/>
                        <Border Background="#FAFAFA" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="15" MinHeight="160" Margin="0,5,0,0">
                            <TextBlock x:Name="txtMotivoDetalle" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="#333"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Diagnóstico y Tratamiento:" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        <Border Background="#FAFAFA" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="15" MinHeight="160" Margin="0,5,0,0">
                            <TextBlock x:Name="txtTratamientoDetalle" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="#333"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource GoMedCardStyle}">
                <StackPanel>
                    <Label Content="📷 Fotografías Adjuntas (clic en una imagen para abrirla):" Margin="0,0,0,10" FontWeight="Bold"/>
                    <ItemsControl x:Name="icFotos">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Background="White" Padding="5" Cursor="Hand">
                                    <Image Source="{Binding}" Width="180" Height="140" Stretch="UniformToFill" MouseDown="Image_MouseDown"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Button Content="← Volver al Historial" HorizontalAlignment="Right" Style="{StaticResource CancelButtonStyle}" Click="BtnCerrar_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>