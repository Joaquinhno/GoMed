<UserControl x:Class="GoMed.VerConsultasWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Encabezado + Botón Nueva Consulta -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Historial de Consultas" Style="{StaticResource ViewTitleStyle}"/>
                <TextBlock Text="Visualiza o busca el registro de atenciones pasadas" Style="{StaticResource ViewSubtitleStyle}"/>
            </StackPanel>

            <Button Content="📝 Nueva Consulta" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}" Click="BtnNuevaConsulta_Click"/>
        </Grid>

        <!-- 2. Buscador Inteligente -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,20">
            <Grid>
                <TextBox x:Name="txtBusqueda" Height="45" VerticalContentAlignment="Center"
                         Padding="40,0,15,0" FontSize="15" BorderThickness="0" Background="Transparent"
                         TextChanged="TxtBusqueda_TextChanged"/>

                <TextBlock IsHitTestVisible="False" Text="🔍   Buscar paciente por nombre o apellido..."
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,0,0"
                           Foreground="#AAA" FontSize="15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtBusqueda}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 3. Tabla de Datos en Tarjeta -->
        <Border Grid.Row="2" Style="{StaticResource GoMedCardStyle}" Padding="10" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <DataGrid x:Name="dgConsultas" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0" RowHeight="45" FontSize="14"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0" SelectionMode="Single">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#888888"/>
                        <Setter Property="Padding" Value="15,0,0,12"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8F9FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E8F4FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource Mode=Self}}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="FechaTextStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#7F8C8D"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>

                    <Style x:Key="PacienteTextStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#2C3E50"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="15"/>
                    </Style>

                    <Style x:Key="MotivoTextStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#555555"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat=\{0:dd/MM/yyyy\}}" Width="115"
                                        ElementStyle="{StaticResource FechaTextStyle}"/>

                    <DataGridTextColumn Header="PACIENTE" Binding="{Binding PacienteNombre}" Width="1.5*"
                                        ElementStyle="{StaticResource PacienteTextStyle}"/>

                    <DataGridTextColumn Header="MOTIVO DE CONSULTA" Binding="{Binding Motivo}" Width="2.5*"
                                        ElementStyle="{StaticResource MotivoTextStyle}"/>

                    <DataGridTemplateColumn Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <Button Content="Ver Detalles" Click="BtnVerDetalle_Click"
                                            Style="{StaticResource GridActionBtnStyle}" Background="{StaticResource PrimaryBlueBrush}"/>

                                    <Button Content="Eliminar" Click="BtnEliminar_Click"
                                            Style="{StaticResource GridActionBtnStyle}" Background="#DC3545"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>