<UserControl x:Class="GoMed.VerFichaPacienteWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="40,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de búsqueda superior -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" Padding="18,10" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍   Buscar Paciente:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox Grid.Column="1" x:Name="cmbPaciente"
                          Background="Transparent" BorderThickness="0"
                          IsEditable="True"
                          DisplayMemberPath="NombreCompleto"
                          SelectedValuePath="PacienteID"
                          SelectionChanged="CmbPaciente_SelectionChanged"
                          VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Datos de cabecera del Paciente -->
        <Border Grid.Row="1" Margin="5,0,5,15">
            <StackPanel>
                <TextBlock x:Name="txtNombrePaciente" Text="Seleccione un Paciente" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}"/>
                <TextBlock x:Name="txtDniPaciente" Text="DNI: ---" FontSize="16" Foreground="{DynamicResource PrimaryBlueBrush}" FontWeight="SemiBold" Margin="2,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Cuadrícula 2x2 de Tarjetas de Historia Clínica -->
        <UniformGrid Grid.Row="2" Columns="2">

            <Border Style="{StaticResource GoMedCardStyle}" Margin="0,0,12,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="👤" FontSize="22" Margin="0,0,12,0"/>
                        <TextBlock Text="Antecedentes Personales" Style="{StaticResource SectionHeaderStyle}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtPers" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource TextLightBrush}" LineHeight="22"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource GoMedCardStyle}" Margin="12,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="👨‍👩‍👧" FontSize="22" Margin="0,0,12,0"/>
                        <TextBlock Text="Antecedentes Familiares" Style="{StaticResource SectionHeaderStyle}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtFam" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource TextLightBrush}" LineHeight="22"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource GoMedCardStyle}" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="💪" FontSize="22" Margin="0,0,12,0"/>
                        <TextBlock Text="Examen Físico" Style="{StaticResource SectionHeaderStyle}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtExamen" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource TextLightBrush}" LineHeight="22"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource GoMedCardStyle}" Margin="12,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="📄" FontSize="22" Margin="0,0,12,0"/>
                        <TextBlock Text="Notas Clínicas" Style="{StaticResource SectionHeaderStyle}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtNotas" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic" LineHeight="22"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </UniformGrid>
    </Grid>
</UserControl>