<Window x:Class="GoMed.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoMed - Panel Principal" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F8F9FA">

    <Window.Resources>

        <!-- ESTILO PREMIUM ANIMADO (Corregido para el diseñador de VS) -->
        <Style x:Key="DashboardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <!-- La Tarjeta Base -->
                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="15" Margin="15" Width="280" Height="200"
                                BorderThickness="2" RenderTransformOrigin="0.5,0.5">

                            <Border.BorderBrush>
                                <SolidColorBrush Color="#EEEEEE"/>
                            </Border.BorderBrush>

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Animaciones Suaves -->
                        <ControlTemplate.Triggers>

                            <!-- Cuando el Mouse ENTRA -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#007BFF" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.12" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="25" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Cuando el Mouse SALE -->
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#EEEEEE" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.05" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="15" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Cuando se hace CLIC -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F1F8FF"/>
                                <Setter TargetName="CardBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="40,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="btnVolver" Content="←" FontSize="24" Background="Transparent" 
                            BorderThickness="0" Margin="0,0,15,0" Visibility="Collapsed" 
                            Click="BtnVolver_Click" Cursor="Hand" Foreground="#007BFF"/>
                    <TextBlock Text="GoMed" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="lblNombreDoctor" Text="Dr. Daniel Infante" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="#555" FontWeight="SemiBold"/>

                    <Border Background="#FFF3CD" CornerRadius="8" Padding="8,4" Margin="0,0,10,0" Cursor="Hand" MouseDown="BtnRestaurar_MouseDown" ToolTip="Restaurar Copia de Seguridad">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text=" Restaurar" FontSize="12" Foreground="#856404" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#E8F4FF" CornerRadius="8" Padding="8,4" Margin="0,0,15,0" Cursor="Hand" MouseDown="BtnBackup_MouseDown" ToolTip="Crear Copia de Seguridad">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text=" Respaldar" FontSize="12" Foreground="#007BFF" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1">
            <UniformGrid x:Name="MenuPrincipal" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnPacientes_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="👤" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Pacientes" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                        <TextBlock Text="Gestionar perfiles" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnFichaMenu_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Ficha Clínica" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                        <TextBlock Text="Antecedentes y notas" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnConsultaMenu_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="📅" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Consultas" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                        <TextBlock Text="Cargar y ver citas" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnAbrirRecetas_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="💊" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Receta Médica" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                        <TextBlock Text="Emitir prescripciones" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- SUBMENÚS -->
            <UniformGrid x:Name="SubMenuPacientes" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnAgregarPaciente_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="➕" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Agregar Paciente" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnVisualizarPacientes_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="👁️" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Visualizar Pacientes" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <UniformGrid x:Name="SubMenuFicha" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnAgregarFicha_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="✍️" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Agregar Ficha" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnRevisionFicha_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Revisión de Ficha" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <UniformGrid x:Name="SubMenuConsulta" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnAgregarConsulta_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="📝" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Agregar Consulta" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnVisualizarConsultas_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Visualizar Consultas" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>