<Window x:Class="GoMed.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoMed - Sistema de Gestión Médica"
        Height="780" Width="1250"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR IZQUIERDO ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Logo GoMed -->
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,20" Orientation="Horizontal">
                    <TextBlock Text="⚕ GoMed" Foreground="{DynamicResource PrimaryBlueBrush}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>

                <!-- Pie del Sidebar -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,18">
                    <Separator Background="{DynamicResource BorderCardBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="Sistema de Consultorio" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,2"/>
                    <TextBlock Text="GoMed v1.0" FontSize="11" Foreground="{DynamicResource PlaceholderTextBrush}" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Menú de Navegación Persistente -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0">
                    <StackPanel Margin="6,0,6,10">
                        <Button x:Name="btnNavInicio" Content="🏠   Inicio" Style="{StaticResource SidebarButtonActiveStyle}" Click="BtnNavInicio_Click"/>

                        <TextBlock Text="PACIENTES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,18,0,4"/>
                        <Button x:Name="btnNavPacientes" Content="👥   Listado de Pacientes" Style="{StaticResource SidebarButtonStyle}" Click="BtnVisualizarPacientes_Click"/>
                        <Button x:Name="btnNavNuevoPaciente" Content="➕   Agregar Paciente" Style="{StaticResource SidebarButtonStyle}" Click="BtnAgregarPaciente_Click"/>

                        <TextBlock Text="HISTORIA CLÍNICA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,18,0,4"/>
                        <Button x:Name="btnNavFichaEditar" Content="📋   Editar Ficha Clínica" Style="{StaticResource SidebarButtonStyle}" Click="BtnAgregarFicha_Click"/>
                        <Button x:Name="btnNavFichaVer" Content="🔍   Revisión de Ficha" Style="{StaticResource SidebarButtonStyle}" Click="BtnRevisionFicha_Click"/>

                        <TextBlock Text="CONSULTAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,18,0,4"/>
                        <Button x:Name="btnNavConsultas" Content="📊   Historial de Consultas" Style="{StaticResource SidebarButtonStyle}" Click="BtnVisualizarConsultas_Click"/>
                        <Button x:Name="btnNavNuevaConsulta" Content="📝   Nueva Consulta" Style="{StaticResource SidebarButtonStyle}" Click="BtnAgregarConsulta_Click"/>

                        <TextBlock Text="PRESCRIPCIONES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,18,0,4"/>
                        <Button x:Name="btnNavRecetas" Content="💊   Receta Médica" Style="{StaticResource SidebarButtonStyle}" Click="BtnAbrirRecetas_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== ÁREA PRINCIPAL ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO SUPERIOR PERSISTENTE -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="35,0">
                    <!-- Izquierda: Botón Volver contextual y Breadcrumb -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="btnVolver" Content="← Volver"
                                Style="{StaticResource CancelButtonStyle}"
                                Padding="14,6" Margin="0,0,15,0"
                                Visibility="Collapsed"
                                Click="BtnVolver_Click"/>
                        <TextBlock x:Name="lblSeccionActual" Text="Panel Principal"
                                   VerticalAlignment="Center" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDarkBrush}"/>
                    </StackPanel>

                    <!-- Derecha: Médico logueado + Botón Tema + Restaurar / Respaldar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="lblNombreDoctor" Text="Dr. Daniel Infante"
                                   VerticalAlignment="Center" Margin="0,0,18,0"
                                   Foreground="{DynamicResource TextLightBrush}" FontSize="14" FontWeight="SemiBold"/>

                        <!-- BOTÓN MODO OSCURO / CLARO -->
                        <Border Background="{DynamicResource SidebarBackgroundHoverBrush}"
                                BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6" Margin="0,0,10,0"
                                Cursor="Hand" MouseDown="BtnTema_MouseDown" ToolTip="Alternar Modo Claro / Oscuro">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="lblIconoTema" Text="🌙" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblTextoTema" Text=" Oscuro" FontSize="12" Foreground="{DynamicResource TextDarkBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource WarningBgBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,10,0"
                                Cursor="Hand" MouseDown="BtnRestaurar_MouseDown" ToolTip="Restaurar Copia de Seguridad">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text=" Restaurar" FontSize="12" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SidebarBackgroundActiveBrush}" CornerRadius="8" Padding="10,6"
                                Cursor="Hand" MouseDown="BtnBackup_MouseDown" ToolTip="Crear Copia de Seguridad">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text=" Respaldar" FontSize="12" Foreground="{DynamicResource PrimaryBlueBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ÁREA DE CONTENIDO DINÁMICO -->
            <Grid Grid.Row="1">
                <!-- DASHBOARD DE INICIO -->
                <ScrollViewer x:Name="VistaInicio" VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                        <TextBlock Text="Bienvenido a GoMed" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource TextDarkBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Seleccione un módulo para comenzar a trabajar" FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <UniformGrid x:Name="MenuPrincipal" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnPacientes_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Pacientes" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}"/>
                                    <TextBlock Text="Ver padrón y gestionar perfiles" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnFichaMenu_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Ficha Clínica" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}"/>
                                    <TextBlock Text="Antecedentes, examen y notas" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnConsultaMenu_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="📅" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Consultas" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}"/>
                                    <TextBlock Text="Registrar y consultar atenciones" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DashboardButtonStyle}" Click="BtnAbrirRecetas_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="💊" FontSize="45" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Receta Médica" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}"/>
                                    <TextBlock Text="Emitir prescripciones en PDF" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- CONTENEDOR DONDE SE CARGAN LOS USERCONTROLS -->
                <ContentControl x:Name="MainContent" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>