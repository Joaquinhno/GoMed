<Window x:Class="GoMed.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoMed"
        mc:Ignorable="d"
        Title="GoMed - Iniciar Sesión" 
        Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        ResizeMode="NoResize">

    <Border Padding="30" BorderBrush="#E0E0E0" BorderThickness="1" Background="White" Margin="20" CornerRadius="8">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="⚕ GoMed" 
                       Foreground="#007BFF" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,10"/>

            <TextBlock Text="Bienvenido de nuevo" 
                       FontSize="18" 
                       Foreground="#495057" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <Label Content="Email:"/>
            <TextBox x:Name="txtEmail" Padding="10,8" BorderBrush="#CED4DA" BorderThickness="1"/>

            <CheckBox x:Name="chkRecordarEmail" 
              Content="Recordar mi email" 
              Margin="0,15,0,0" 
              Foreground="#495057"
              Cursor="Hand"/>

            <Label Content="Contraseña:" Margin="0,15,0,0"/>
            <PasswordBox x:Name="txtPassword" Padding="10,8" BorderBrush="#CED4DA" BorderThickness="1"/>

            <Button x:Name="btnLogin" 
                    Content="Iniciar Sesión" 
                    Style="{StaticResource SaveButtonStyle}" 
                    Margin="0,30,0,0" 
                    Padding="12"
                    FontSize="16"
                    Click="BtnLogin_Click"
                    IsDefault="True"/>

            <Button x:Name="btnMostrarRegistro" 
                    Content="¿No tienes cuenta? Regístrate" 
                    Style="{StaticResource CancelButtonStyle}" 
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#007BFF"
                    Margin="0,15,0,0" 
                    Cursor="Hand"
                    Click="BtnMostrarRegistro_Click"/>

        </StackPanel>
    </Border>
</Window>