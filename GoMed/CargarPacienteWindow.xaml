<Window x:Class="GoMed.CargarPacienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cargar Nuevo Paciente" 
        Height="760" Width="1200" 
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB"
        WindowState="Maximized">

    <Window.Resources>
        <Color x:Key="PrimaryBlueColor">#0D6EFD</Color>
        <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlueColor}"/>
        <SolidColorBrush x:Key="LightBlueBg" Color="#F0F5FF"/>
        <SolidColorBrush x:Key="TextDark" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#CBD5E1"/>

        <!-- Estilo de Tarjeta Responsiva -->
        <Style x:Key="WebCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="30,20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.03" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="InputBorderStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== BARRA LATERAL ===== -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,30,0,0">
                    <StackPanel Orientation="Horizontal" Margin="25,0,0,40">
                        <TextBlock Text="⚕" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="28" FontWeight="Bold" Margin="0,0,10,0"/>
                        <TextBlock Text="GoMed" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>

                    <Button x:Name="btnVolver" Content="←   Volver" Style="{StaticResource NavButtonStyle}" Click="BtnVolver_Click"/>

                    <Border Background="{StaticResource LightBlueBg}" CornerRadius="8" Margin="10,5">
                        <Button Content="👤   Perfil Paciente" Style="{StaticResource NavButtonStyle}" Foreground="{StaticResource PrimaryBlueBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="25">
                    <Separator Background="#E2E8F0" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" Cursor="Hand">
                        <TextBlock Text="⚙" FontSize="18" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0"/>
                        <TextBlock Text="Gestión de Pacientes" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- ===== CONTENIDO PRINCIPAL (100% RESPONSIVO) ===== -->
        <Grid Grid.Column="1" Margin="50,30,50,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Título Superior -->
                <RowDefinition Height="*"/>
                <!-- Tarjeta Dinámica -->
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="{StaticResource LightBlueBg}" Width="50" Height="50" CornerRadius="10" Margin="0,0,15,0">
                    <TextBlock Text="👤" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Ficha de Paciente" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}"/>
                    <TextBlock Text="Complete los datos personales y de contacto" FontSize="15" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- TARJETA DEL FORMULARIO QUE SE ADAPTA AL ALTO -->
            <Border Grid.Row="1" Style="{StaticResource WebCardStyle}">
                <!-- Subdivisión interna de la tarjeta -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- "Datos Personales" -->
                        <RowDefinition Height="*"/>
                        <!-- Formulario Dinámico -->
                        <RowDefinition Height="Auto"/>
                        <!-- Botones Guardar -->
                    </Grid.RowDefinitions>

                    <!-- Encabezado interior -->
                    <Border Grid.Row="0" Background="{StaticResource LightBlueBg}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" Foreground="{StaticResource PrimaryBlueBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Datos personales" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- CUADRÍCULA DEL FORMULARIO (Se estira y encoge automáticamente) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <!-- El Asterisco (*) hace que las filas compartan el espacio por igual -->
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- FILA 1 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="👤" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                <TextBlock Text="Nombre *" Style="{StaticResource LabelStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <Grid>
                                    <TextBox x:Name="txtNombre" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Ingrese el nombre" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtNombre}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="👤" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                <TextBlock Text="Apellido *" Style="{StaticResource LabelStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <Grid>
                                    <TextBox x:Name="txtApellido" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Ingrese el apellido" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtApellido}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- FILA 2 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="💳" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                <TextBlock Text="D.N.I. *" Style="{StaticResource LabelStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <Grid>
                                    <TextBox x:Name="txtDni" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Ingrese el número de documento" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtDni}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="📅" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                <TextBlock Text="Fecha de Nacimiento y Edad *" Style="{StaticResource LabelStyle}"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource InputBorderStyle}">
                                    <DatePicker x:Name="dpFechaNacimiento" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" SelectedDateChanged="DpFechaNacimiento_SelectedDateChanged"/>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource LightBlueBg}" CornerRadius="6">
                                    <TextBlock x:Name="lblEdad" FontSize="14" Foreground="{StaticResource PrimaryBlueBrush}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Text="-- años"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- FILA 3 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="📞" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                <TextBlock Text="Teléfono Móvil" Style="{StaticResource LabelStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <Grid>
                                    <TextBox x:Name="txtTelefono" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Ingrese el número de celular" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtTelefono}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="✉️" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                <TextBlock Text="Correo Electrónico (Email)" Style="{StaticResource LabelStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <Grid>
                                    <TextBox x:Name="txtEmail" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Ingrese el correo electrónico" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtEmail}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- FILA 4 -->
                        <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="📍" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                <TextBlock Text="Lugar de Nacimiento" Style="{StaticResource LabelStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <ComboBox x:Name="cmbLugarNacimiento" IsEditable="True" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="💼" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                <TextBlock Text="Ocupación / Profesión" Style="{StaticResource LabelStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <Grid>
                                    <TextBox x:Name="txtOcupacion" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Ingrese la ocupación o profesión" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtOcupacion}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- FILA 5 -->
                        <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="⚧" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                <TextBlock Text="Género" Style="{StaticResource LabelStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbMasculino" Content="Masculino" GroupName="Genero" Margin="0,0,30,0" FontSize="14" Foreground="{StaticResource TextDark}" Cursor="Hand"/>
                                <RadioButton x:Name="rbFemenino" Content="Femenino" GroupName="Genero" Margin="0,0,30,0" FontSize="14" Foreground="{StaticResource TextDark}" Cursor="Hand"/>
                                <RadioButton x:Name="rbOtro" Content="Otro" GroupName="Genero" FontSize="14" Foreground="{StaticResource TextDark}" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="💍" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                <TextBlock Text="Estado Civil" Style="{StaticResource LabelStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbSoltero" Content="Soltero/a" GroupName="EstadoCivil" Margin="0,0,30,0" FontSize="14" Foreground="{StaticResource TextDark}" Cursor="Hand"/>
                                <RadioButton x:Name="rbCasado" Content="Casado/a" GroupName="EstadoCivil" Margin="0,0,30,0" FontSize="14" Foreground="{StaticResource TextDark}" Cursor="Hand"/>
                                <RadioButton x:Name="rbDivorciado" Content="Divorciado/a" GroupName="EstadoCivil" Margin="0,0,30,0" FontSize="14" Foreground="{StaticResource TextDark}" Cursor="Hand"/>
                                <RadioButton x:Name="rbViudo" Content="Viudo/a" GroupName="EstadoCivil" FontSize="14" Foreground="{StaticResource TextDark}" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- FILA 6 -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🏠" Foreground="{StaticResource PrimaryBlueBrush}"/>
                                <TextBlock Text="Dirección de Domicilio" Style="{StaticResource LabelStyle}"/>
                            </StackPanel>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <Grid>
                                    <TextBox x:Name="txtDireccion" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Ingrese la dirección completa" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=txtDireccion}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- SEPARADOR Y BOTONES -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Separator Background="{StaticResource BorderColor}" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnCancelar" Content="Cancelar" Click="btnCancelar_Click" 
                                    Background="White" Foreground="{StaticResource TextDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" 
                                    Padding="30,10" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,15,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="btnGuardar" Click="BtnGuardar_Click" 
                                    Background="{StaticResource PrimaryBlueBrush}" Foreground="White" BorderThickness="0" 
                                    Padding="30,10" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                                <TextBlock Text="💾" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="Guardar Paciente" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>