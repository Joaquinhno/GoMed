 using GoMed.Data;
using GoMed.Models;
using Microsoft.EntityFrameworkCore;
using System;
using System.Linq;
using System.Windows;
using System.Windows.Controls;

namespace GoMed
{
    <summary>
    Lógica de interacción para CargarConsultaWindow.xaml
    </summary>
public partial class CargarConsultaWindow : Window
    {
        public CargarConsultaWindow()
        {
            InitializeComponent();
            CargarPacientes();
        }

        // Carga la lista de pacientes en el ComboBox de búsqueda
        private void CargarPacientes()
        {
            try
            {
                using (var context = new GoMed.Data.AppContext())
                {
                    // Obtenemos los pacientes y los formateamos para el ComboBox
                    var pacientes = context.Pacientes
                        .Select(p => new
                        {
                            p.PacienteID,
                            p.FechaNacimiento,
                            DisplayText = $"{p.Nombre} {p.Apellido} (DNI: {p.Dni})"
                        })
                        .ToList();

                    cmbPaciente.ItemsSource = pacientes;
                    cmbPaciente.DisplayMemberPath = "DisplayText"; // Lo que se muestra
                    cmbPaciente.SelectedValuePath = "PacienteID"; // El valor real
                }
            }
            catch (Exception ex)
            {
                // Manejo de error si la base de datos no está accesible
                MessageBox.Show($"Error al cargar pacientes: {ex.Message}", "Error de Base de Datos", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        // Cuando se selecciona un paciente, calcula su edad
        private void CmbPaciente_SelectionChanged(object sender, SelectionChangedEventArgs e)
        {
            if (cmbPaciente.SelectedItem == null)
            {
                lblEdad.Text = "-- años";
                return;
            }

            // Obtenemos la fecha de nacimiento del objeto anónimo que guardamos
            DateTime fechaNacimiento = ((dynamic)cmbPaciente.SelectedItem).FechaNacimiento;

            // Calcular la edad
            var hoy = DateTime.Today;
            int edad = hoy.Year - fechaNacimiento.Year;
            if (fechaNacimiento.Date > hoy.AddYears(-edad))
            {
                edad--;
            }

            // Mostrar la edad
            lblEdad.Text = $"{edad} años";
        }

        // Guarda la nueva consulta en la base de datos
        private void BtnGuardar_Click(object sender, RoutedEventArgs e)
        {
            // --- 1. VALIDACIÓN ---
            if (cmbPaciente.SelectedItem == null)
            {
                MessageBox.Show("Por favor, seleccione un paciente.", "Datos Incompletos", MessageBoxButton.OK, MessageBoxImage.Warning);
                return;
            }

            if (string.IsNullOrWhiteSpace(txtMotivo.Text))
            {
                MessageBox.Show("Por favor, ingrese un motivo de consulta.", "Datos Incompletos", MessageBoxButton.OK, MessageBoxImage.Warning);
                return;
            }

            // --- 2. RECOLECCIÓN DE DATOS ---
            int pacienteIdSeleccionado = (int)cmbPaciente.SelectedValue;
            // AQUI ASUMIMOS QUE EL USUARIO CONECTADO ES EL ID 1.
            // Más adelante, esto debería venir de la ventana de Login.
            int usuarioIdActual = 1; 

            // --- 3. CREACIÓN DEL OBJETO ---
            var nuevaConsulta = new Consulta
            {
                PacienteID = pacienteIdSeleccionado,
                UsuarioID = usuarioIdActual,
                FechaConsulta = DateTime.Now, // Guarda la fecha y hora actual
                MotivoConsulta = txtMotivo.Text,
                Diagnostico = txtDiagnostico.Text,
                RutaFoto = null // Aún no implementamos la lógica de fotos
            };

            // --- 4. GUARDADO EN BASE DE DATOS ---
            try
            {
                using (var context = new GoMed.Data.AppContext())
                {
                    context.Consultas.Add(nuevaConsulta);
                    context.SaveChanges();
                }

                MessageBox.Show("Consulta guardada exitosamente.", "Éxito", MessageBoxButton.OK, MessageBoxImage.Information);
                this.Close(); // Cierra la ventana
            }
            catch (Exception ex)
            {
                Exception innerEx = ex;
                while (innerEx.InnerException != null) innerEx = innerEx.InnerException;
                string errorMessage = innerEx.Message;
                MessageBox.Show($"Ocurrió un error al guardar la consulta:\n\n{errorMessage}", "Error de Base de Datos", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        // Cierra la ventana
        private void BtnCancelar_Click(object sender, RoutedEventArgs e)
        {
            this.Close();
        }

        // Cierra esta ventana (y en el futuro podría reabrir la principal)
        private void BtnVolverInicio_Click(object sender, RoutedEventArgs e)
        {
            this.Close();
        }
    }
}

